{
  "name": "tongyun_app-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "通韵 TongYun App 桌面应用（Electron 壳 + Python 桥接后端）",
  "author": "TongYun App contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.tongyun.bci",
    "productName": "通韵 TongYun",
    "copyright": "Copyright © 2026 TongYun App",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../tongyun-bci-algorithm/tongyun_bci_algorithm",
        "to": "tongyun-bci-algorithm/tongyun_bci_algorithm"
      },
      {
        "from": "../tongyun-bci-algorithm/LICENSE",
        "to": "tongyun-bci-algorithm/LICENSE"
      },
      {
        "from": "../requirements-backend.txt",
        "to": "requirements-backend.txt"
      },
      {
        "from": "../sample-data",
        "to": "sample-data"
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "通韵 TongYun",
      "artifactName": "TongYun-App-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TongYun-App-Portable-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
